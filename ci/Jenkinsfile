// Mind Recipe CI — mirrors the GitHub Actions workflows exactly
// (.github/workflows/android-apk.yml + ios-ipa.yml), so builds are identical
// whether they run in Actions (billing permitting) or here on Jenkins.
//
// Stages:
//   APK  — always (Linux or mac agent with Flutter + Android SDK)
//   IPA  — only when Xcode is present (macOS agent); unsigned, same as Actions
//
// Agent requirement: label 'flutter' with Flutter SDK + Android SDK on PATH.
// For IPA: macOS agent with full Xcode (xcode-select -s /Applications/Xcode.app).

pipeline {
  agent none

  environment {
    MIND_RECIPE_STAGING_API_URL = 'https://staging-api.mindrecipe.142.93.201.156.sslip.io'
    FLUTTER_DIR = 'flutter'
    MIND_RECIPE_DRIVE_FOLDER = '14JIW3fnMrR9-e4akDTgfgFYiS73r3Kvd'
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '30'))
  }

  stages {
    stage('Build and analyze on macOS') {
      agent { label 'mac-builder' }
      steps {
        deleteDir()
        checkout scm
        dir("${FLUTTER_DIR}") {
          sh 'flutter pub get'
          sh 'flutter analyze --no-fatal-infos --no-fatal-warnings || true'
        }
        // The macOS node remains the current Flutter/Android reference runner.
        // IPA provisioning is isolated in Tart below and requires no Apple ID.
        dir("${FLUTTER_DIR}") {
          sh '''
            flutter build apk --release --target-platform android-arm64 \
              --dart-define=MIND_RECIPE_API_BASE=${MIND_RECIPE_STAGING_API_URL}
          '''
        }
        stash(name: 'apk', includes: 'flutter/build/app/outputs/flutter-apk/app-release.apk')
        sh 'chmod +x ci/build_ios_in_tart.sh && ci/build_ios_in_tart.sh'
        stash(name: 'ipa', includes: 'flutter/build/ios/ipa/mind-recipe-ios-unsigned.ipa')
      }
    }

    stage('Deliver builds to Google Drive') {
      agent { label 'built-in' }
      steps {
        deleteDir()
        checkout scm
        unstash 'apk'
        unstash 'ipa'
        withCredentials([file(credentialsId: 'mind-recipe-google-drive-service-account', variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
          sh '''
            chmod +x ci/upload_drive.sh
            ci/upload_drive.sh flutter/build/app/outputs/flutter-apk/app-release.apk \
              Mind-Recipe-1.0.0-2084-Android.apk "$MIND_RECIPE_DRIVE_FOLDER"
            ci/upload_drive.sh flutter/build/ios/ipa/mind-recipe-ios-unsigned.ipa \
              Mind-Recipe-1.0.0-2084-iOS-unsigned.ipa "$MIND_RECIPE_DRIVE_FOLDER" \
              victoria@contextfield.co
          '''
        }
        archiveArtifacts(
          artifacts: 'flutter/build/app/outputs/flutter-apk/app-release.apk,flutter/build/ios/ipa/mind-recipe-ios-unsigned.ipa',
          fingerprint: true,
        )
      }
    }
  }

  post {
    always {
      echo 'Jenkins build finished; artifacts are archived only after both platform builds succeed.'
    }
    success {
      echo "Mind Recipe build #${env.BUILD_NUMBER} — artifacts archived in Jenkins."
    }
    failure {
      echo 'Mind Recipe build failed — check the stage that failed.'
    }
  }
}
